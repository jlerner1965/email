# Lead capture for the grade selector.
#
# VITE_RFQ_ENDPOINT — where a completed sample request POSTs.
#   Formspree:   https://formspree.io/f/xxxxxxxx     (mode json)
#   Getform etc: any URL that accepts a JSON body    (mode json)
#   Own handler: must send CORS headers for the site (mode json)
#   Netlify:     /                                   (mode netlify;
#                deploy netlify-sample.html with the site)
#
# Leave VITE_RFQ_ENDPOINT unset and the widget simulates dispatch, so
# the page stays demoable with no backend.

VITE_RFQ_ENDPOINT=
VITE_RFQ_MODE=json
